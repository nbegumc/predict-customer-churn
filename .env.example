# Copy to .env and set. `.env` is gitignored and refused by a pre-commit hook,
# so this example is the committed version.

# Which bundle the image serves. Must be a directory under models/ holding a
# manifest.json -- `ls models/` after a training run.
MODEL_RUN_ID=1024_141318_lgbm

# fold_average (default) or full_refit. Both live in the same bundle;
# notebooks/03_serving_strategy.ipynb is why fold_average is the default.
MODEL_STRATEGY=fold_average
