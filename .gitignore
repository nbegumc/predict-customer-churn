# data — never commit
data/raw/*
data/interim/*
data/processed/*
!data/**/.gitkeep

# artifacts
experiments/*.npy
experiments/*.json
experiments/*.csv
submissions/*.csv
!**/.gitkeep

# secrets
kaggle.json
.env

# python / uv
__pycache__/
*.py[cod]
.venv/
venv/
# uv.lock is committed on purpose — it pins the shared environment
# generated only for Kaggle kernels, via `make requirements`
requirements.txt
.ipynb_checkpoints/
.pytest_cache/
*.egg-info/

# os
.DS_Store
Thumbs.db

# model bundles, tracking store and serving logs
# A fold bundle is ~30MB (5 boosters), so it never goes in git — the model
# channel is a GitHub Release, and MLflow holds the run that produced it.
models/
mlruns/
mlflow.db
logs/
reports/drift_*.html

# dvc keeps pointers in git; the cache and tmp dirs stay local
.dvc/cache/
.dvc/tmp/
dist/
/experiments
